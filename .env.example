# ==========================================
# Exemplo de Variáveis de Ambiente - HuNails
# ==========================================
# IMPORTANTE: Nunca versione o arquivo .env real no GitHub.
# Copie este arquivo, renomeie para .env e preencha com seus dados locais.

# --- Configurações do Banco de Dados (PostgreSQL) ---
# Substitua os valores abaixo de acordo com seu banco local ou na nuvem (ex: Supabase)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/hunails_db
SPRING_DATASOURCE_USERNAME=meu_usuario_local
SPRING_DATASOURCE_PASSWORD=minha_senha_super_secreta

# --- Configurações de Segurança (JWT) ---
# A chave secreta deve ter pelo menos 32 caracteres (256 bits).
# Exemplo gerado aleatoriamente apenas para ilustração.
JWT_SECRET=abc123def456ghi789jkl012mno345pqr678stu901vwx234yz
# Tempo de expiração do token em milissegundos (86400000 ms = 24 horas)
JWT_EXPIRATION_MS=86400000